  "style": {
    "rules": [
      "Verdichtungsstil: keine Füllwörter, keine Passivkonstruktionen",
      "Keine Diagnose, keine Therapieempfehlung im Rohtext",
      "Anatomische Präzision: HWS-Bereich / Halswirbelsäule, nicht 'Nacken' oder 'Hals' allein",
      "Ausstrahlungen explizit benennen wenn vorhanden",
      "Zeitlicher Verlauf als Adjektiv-Präfix: Chronische / Intermittierende / Belastungsabhängige Schmerzen",
      "Schmerzcharakter als Adjektiv-Modifikator: ziehende, stechende, dumpfe, verspannungsartige Schmerzen",
      "Verstärkende Faktoren mit 'verstärkt bei'",
      "Lindernde Faktoren mit 'gebessert durch'",
      "Maximal 2 Sätze pro Hauptbeschwerdeblock"
    ],
    "preferred_phrases": {
      "anchor": [
        "Schmerzen im HWS-Bereich"
      ]
    },
    "forbidden_words": [
      "wahrscheinlich",
      "vermutlich",
      "empfohlen",
      "sollte",
      "spricht für",
      "könnte",
      "möglicherweise"
    ],
    "examples": [
      {
        "input": "Chronische verspannungsartige Schmerzen HWS beidseits, VAS 5, verstärkt bei langem Sitzen, gebessert durch Wärme",
        "output": "Chronische, verspannungsartige Schmerzen im HWS-Bereich beidseits, verstärkt bei langem Sitzen, gebessert durch Wärme."
      },
      {
        "input": "Stechende Schmerzen HWS rechts mit Ausstrahlung in den rechten Arm, Kribbeln in Fingern",
        "output": "Stechende Schmerzen im HWS-Bereich rechts mit Ausstrahlung in den rechten Arm, begleitet von Kribbeln."
      },
      {
        "input": "Ziehende Schmerzen HWS, verstärkt bei Computerarbeit, gebessert durch Massage",
        "output": "Ziehende Schmerzen im HWS-Bereich, verstärkt bei Computerarbeit, gebessert durch Massage."
      }
    ]
  },
