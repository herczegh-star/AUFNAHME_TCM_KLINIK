  "style": {
    "rules": [
      "Verdichtungsstil: keine Fuellwoerter, keine Passivkonstruktionen",
      "Keine Diagnose, keine Therapieempfehlung im Rohtext",
      "Anatomische Praezision: LWS-Bereich, nicht 'Ruecken' oder 'Koerper'",
      "Ausstrahlungen explizit benennen wenn vorhanden",
      "Zeitlicher Verlauf als Adjektiv-Praefix: Chronische / Intermittierende / Belastungsabhaengige Schmerzen",
      "Schmerzcharakter als Adjektiv-Modifikator: ziehende, stechende, dumpfe Schmerzen",
      "Verstaeркende Faktoren mit 'verstaerkt bei': verstaerkt bei langem Sitzen",
      "Lindernde Faktoren mit 'gebessert durch': gebessert durch Waerme",
      "Funktionelle Einschraenkungen am Satzende oder als separater Satz",
      "Maximal 2 Saetze pro Hauptbeschwerdeblock"
    ],
    "preferred_patterns": [
      "[Temporalitaet] [Charakter] Schmerzen im LWS-Bereich [Seite] [Ausstrahlung], verstaerkt bei [Faktor], gebessert durch [Faktor].",
      "[Charakter] Schmerzen im LWS-Bereich [Seite] seit [Dauer].",
      "Chronische Schmerzen im LWS-Bereich beidseits mit Ausstrahlung ins [Ziel], verstaerkt bei [Faktor].",
      "Belastungsabhaengige [Charakter] Schmerzen im LWS-Bereich [Seite], gebessert durch [Faktor]."
    ],
    "preferred_phrases": {
      "anchor": [
        "Schmerzen im LWS-Bereich"
      ],
      "temporality": [
        "Chronische",
        "Intermittierende",
        "Belastungsabhaengige",
        "Progrediente"
      ],
      "character": [
        "ziehende",
        "stechende",
        "dumpfe",
        "brennende",
        "krampfartige"
      ],
      "aggravating": [
        "verstaerkt bei langem Sitzen",
        "verstaerkt bei langem Stehen",
        "verstaerkt bei Buecken",
        "verstaerkt bei koerperlicher Belastung"
      ],
      "relieving": [
        "gebessert durch Waerme",
        "gebessert durch Ruhe",
        "gebessert durch Liegen",
        "gebessert durch leichte Bewegung"
      ],
      "radiation": [
        "mit Ausstrahlung ins linke Bein",
        "mit Ausstrahlung ins rechte Bein",
        "mit Ausstrahlung ins linke Bein bis zur Ferse",
        "mit Ausstrahlung ins rechte Bein bis zur Ferse",
        "mit Ausstrahlung ins Gesaess"
      ]
    },
    "forbidden_words": [
      "wahrscheinlich",
      "vermutlich",
      "empfohlen",
      "sollte",
      "spricht fuer",
      "koennte",
      "moeglicherweise"
    ],
    "examples": [
      {
        "input": "Chronische ziehende Schmerzen LWS beidseits, VAS 6, verstaerkt bei langem Sitzen, gebessert durch Waerme",
        "output": "Chronische, ziehende Schmerzen im LWS-Bereich beidseits, verstaerkt bei langem Sitzen, gebessert durch Waerme."
      },
      {
        "input": "Stechende Schmerzen LWS rechts mit Ausstrahlung ins rechte Bein bis zur Ferse, Kribbeln, VAS 7",
        "output": "Stechende Schmerzen im LWS-Bereich rechts mit Ausstrahlung ins rechte Bein bis zur Ferse."
      },
      {
        "input": "Belastungsabhaengige dumpfe Schmerzen LWS, verstaerkt bei Buecken und Treppensteigen, gebessert durch Ruhe",
        "output": "Belastungsabhaengige, dumpfe Schmerzen im LWS-Bereich, verstaerkt bei Buecken, gebessert durch Ruhe."
      }
    ]
  },
