  "form": {
    "title": "LWS-Syndrom – Anamnese",
    "fields": [
      {
        "id": "duration",
        "label": "Beschwerdedauer",
        "type": "text",
        "placeholder": "z. B. 3 Wochen, seit 2 Jahren",
        "required": true,
        "normalization_map": null
      },
      {
        "id": "character",
        "label": "Schmerzcharakter",
        "type": "multi_select",
        "options": [
          "ziehend",
          "stechend",
          "dumpf",
          "brennend",
          "krampfartig",
          "drueckend",
          "elektrisierend",
          "pulsierend"
        ],
        "required": false,
        "normalization_map": "character"
      },
      {
        "id": "pain_temporality",
        "label": "Zeitlicher Verlauf",
        "type": "select",
        "options": [
          "chronisch",
          "intermittierend",
          "belastungsabhaengig",
          "progredient"
        ],
        "required": false,
        "normalization_map": null
      },
      {
        "id": "radiation",
        "label": "Ausstrahlung",
        "type": "select",
        "options": [
          "keine",
          "Gesaess",
          "linkes_bein",
          "rechtes_bein",
          "linkes_bein_bis_ferse",
          "rechtes_bein_bis_ferse",
          "Leiste",
          "Unterbauch"
        ],
        "required": false,
        "normalization_map": null
      },
      {
        "id": "aggravating_factor",
        "label": "Verstaeркende Faktoren",
        "type": "multi_select",
        "options": [
          "langes_sitzen",
          "langes_stehen",
          "langes_gehen",
          "buecken",
          "treppensteigen",
          "belastung"
        ],
        "required": false,
        "normalization_map": "aggravating"
      },
      {
        "id": "relieving_factor",
        "label": "Lindernde Faktoren",
        "type": "multi_select",
        "options": [
          "waerme",
          "ruhe",
          "liegen",
          "bewegung",
          "massage"
        ],
        "required": false,
        "normalization_map": "relieving"
      },
      {
        "id": "functional_limitations",
        "label": "Funktionelle Einschraenkungen",
        "type": "multi_select",
        "options": [
          "sitting_tolerance",
          "walking_distance",
          "stehen",
          "treppensteigen",
          "schlafstoerung"
        ],
        "required": false,
        "normalization_map": "functional"
      },
      {
        "id": "intensity_vas",
        "label": "Schmerzintensitaet (VAS 0-10)",
        "type": "number",
        "min": 0,
        "max": 10,
        "required": false,
        "normalization_map": null
      },
      {
        "id": "onset",
        "label": "Ausloeser / Beginn",
        "type": "text",
        "placeholder": "z. B. nach Heben, schleichend, nach Unfall",
        "required": false,
        "normalization_map": null
      },
      {
        "id": "neurological_signs",
        "label": "Neurologische Zeichen",
        "type": "multi_select",
        "options": [
          "Taubheit",
          "Kribbeln",
          "Kraftminderung",
          "Reflexabschwaechung",
          "keine"
        ],
        "required": false,
        "normalization_map": null
      },
      {
        "id": "previous_treatment",
        "label": "Vorbehandlung",
        "type": "text",
        "placeholder": "z. B. Physiotherapie, Analgetika, OP",
        "required": false,
        "normalization_map": null
      },
      {
        "id": "additional_notes",
        "label": "Weitere Angaben",
        "type": "textarea",
        "placeholder": "Freitext",
        "required": false,
        "normalization_map": null
      }
    ]
  },
