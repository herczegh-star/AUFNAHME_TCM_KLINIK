  "draft_pipeline": {
    "stages": [
      {
        "id": "raw",
        "label": "Roh-Entwurf",
        "type": "deterministic",
        "description": "Deterministische Satzkonstruktion aus Formularfeldern via render_maps",
        "composer": "lws_narrative_composer.compose_lws_narrative",
        "validation": {
          "forbidden_words": true,
          "max_sentences": 2,
          "require_anchor": true
        }
      },
      {
        "id": "refined",
        "label": "Verfeinerter Entwurf",
        "type": "llm",
        "description": "LLM-Bereinigung: Grammatik, Fluss, keine inhaltliche Aenderung",
        "system_prompt_key": "refine_grammar",
        "temperature": 0.2,
        "validation": {
          "forbidden_words": true,
          "max_sentences": 2,
          "require_anchor": true
        }
      },
      {
        "id": "final",
        "label": "Final-Entwurf",
        "type": "llm",
        "description": "Strikter Verdichtungsstil-Pass: Stil-Regeln + preferred_phrases anwenden",
        "system_prompt_key": "final_verdichtungsstil",
        "temperature": 0.1,
        "validation": {
          "forbidden_words": true,
          "max_sentences": 2,
          "require_anchor": true,
          "check_preferred_patterns": true
        }
      }
    ],
    "fallback_on_llm_error": "raw"
  },
