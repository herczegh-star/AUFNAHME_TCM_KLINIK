      "id": "LWS1",
      "label": "Mechanisches LWS-Syndrom",
      "description": "Belastungsabhaengige lumbale Schmerzen ohne Ausstrahlung, typisch bei muskulaerer oder degenerativer Genese",
      "when_to_use": "Schmerzen lokal LWS-Bereich, keine radikulaere Symptomatik, verstaerkt bei Belastung, gebessert durch Ruhe oder Waerme",
      "template": "Belastungsabhaengige Schmerzen im LWS-Bereich [Seite], verstaerkt bei [Faktor], gebessert durch [Faktor].",
      "tcm_patterns": [
        "Qi-Stagnation",
        "Kaelte-Bi-Syndrom"
      ]
    },
    {
      "id": "LWS2",
      "label": "Radikulaeres LWS-Syndrom",
      "description": "Lumbale Schmerzen mit Ausstrahlung in Bein oder Gesaess, Hinweis auf Nervenwurzelbeteiligung",
      "when_to_use": "Schmerzen mit Ausstrahlung, neurologische Begleitsymptome (Kribbeln, Taubheit, Kraftminderung) moeglich",
      "template": "[Charakter] Schmerzen im LWS-Bereich [Seite] mit Ausstrahlung ins [Ziel][, verstaerkt bei Faktor].",
      "tcm_patterns": [
        "Wind-Kaelte-Bi",
        "Nieren-Yang-Mangel"
      ]
    }
  ],
